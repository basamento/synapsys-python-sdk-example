# Copy this file to .env and fill in the worker token created in Synapsys Core.
SYNAPSYS_CORE_URL=http://localhost:8080
SYNAPSYS_CORE_TOKEN=syn_replace_with_a_worker_token

# Optional example settings.
SYNAPSYS_WORKER_NAME=python-sdk-user-1
SYNAPSYS_HEARTBEAT_INTERVAL=5s
SYNAPSYS_LOG_LEVEL=info
EXAMPLE_PORT=3004

# How long stop() waits for running processes to become terminal before it reports
# them and finishes. The uncancellable examples outlast a short budget on purpose,
# which is what the warning is for.
# SYNAPSYS_SHUTDOWN_TIMEOUT=10s

# Set false to keep remote start/stop while leaving sys.stdout untouched. Process
# output then stays local instead of being streamed to Core.
# SYNAPSYS_CAPTURE_CONSOLE=false

# Disable all SDK networking and console interception when running without Core.
# SYNAPSYS_ENABLED=false

